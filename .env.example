# Copia este archivo a .env.local (que git ignora) y ajusta la URL.
# Base de la API de Giras, sin barra final. Es la URL que imprime infra/desplegar.sh giras.
VITE_API_GIRAS_URL=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/giras

# Voluntariado y Catalogo. URLs de voae-voluntariado y voae-catalogo, sin barra final.
VITE_API_CATALOGO=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/catalogo
VITE_API_VOLUNTARIADO=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/voluntariado

# Reporteria (tableros y estadisticas). URL base de voae-reporteria, sin barra final.
# Si no se define, Voluntariado usa sus rutas provisionales y Giras arma los datos como antes.
VITE_API_REPORTERIA=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/reporteria
