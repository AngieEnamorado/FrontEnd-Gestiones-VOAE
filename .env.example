# Copia este archivo a .env.local (que git ignora) y ajusta la URL.
# Base de la API de Giras, sin barra final. Es la URL que imprime infra/desplegar.sh giras.
VITE_API_GIRAS_URL=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/giras

# Voluntariado y Catalogo. URLs de voae-voluntariado y voae-catalogo, sin barra final.
VITE_API_CATALOGO=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/catalogo
VITE_API_VOLUNTARIADO=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/voluntariado

# Reporteria (tableros y estadisticas de Voluntariado). URL base de voae-reporteria, sin barra final.
# Si no se define, Voluntariado usa sus rutas provisionales.
VITE_API_REPORTERIA=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/reporteria

# PROCAD. URL de voae-procad y la de voae-catalogo con el nombre que lee clienteProcad.ts.
# Sin VITE_API_PROCAD_URL, PROCAD sigue con sus datos de demostracion.
VITE_API_PROCAD_URL=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/procad
VITE_API_CATALOGO_URL=https://TU-ID.execute-api.us-east-1.amazonaws.com/v1/catalogo
# idPersona con el que firma el administrador de PROCAD mientras no haya sesion real.
VITE_PROCAD_ID_PERSONA=0
